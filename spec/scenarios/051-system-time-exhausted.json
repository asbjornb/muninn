{
  "name": "system-time-exhausted",
  "description": "§4.2: once the last stored batch sits at the maximum timestamp there is no last + 1us, so any further write that reaches the system_time step fails with invalid_timestamp and has no effect. A batch-id no-op never reaches that step.",
  "steps": [
    {"op": "create_table", "name": "t", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "s", "table": "t"},
    {"op": "write", "system_time": "9999-12-31T23:59:59.999999Z", "batch_id": "b1",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-01T00:00:00Z", "values": {"value": 1.0}}],
     "expect": {"stored": 1, "duplicates": 0, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-02T00:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-02T00:00:00Z", "values": {"value": 2.0}}],
     "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-02T00:00:00Z", "batch_id": "b1",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-02T00:00:00Z", "values": {"value": 2.0}}],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": true}},
    {"op": "latest", "table": "t",
     "expect": {"rows": [
       {"series": "s", "value_time": "2025-01-01T00:00:00Z", "published_time": null, "received_time": "2025-01-01T00:00:00Z", "system_time": "9999-12-31T23:59:59.999999Z", "seq": 1, "values": {"value": 1.0}}]}}
  ]
}
