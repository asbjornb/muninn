{
  "name": "timestamp-offsets-and-fractions",
  "description": "§1: input timestamps may carry numeric offsets and 0-6 fraction digits; all are converted to UTC microseconds (the writer clock too). Expectations are written in canonical form (no fraction when zero, else exactly 6 digits) but runners compare instants as integers; canonical formatting itself is pinned by the reference's unit tests. Frontier/system/value bounds given with offsets work at microsecond precision.",
  "steps": [
    {"op": "create_table", "name": "t", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "s", "table": "t"},
    {"op": "write", "system_time": "2025-01-15T13:00:00.123456+01:00",
     "rows": [
       {"series": "s", "value_time": "2025-01-16T00:00:00.5Z", "published_time": "2025-01-15T12:30:00+05:30", "received_time": "2025-01-15T11:59:59.999999Z", "values": {"value": 1.0}},
       {"series": "s", "value_time": "2025-01-16T00:00:00.000001Z", "received_time": "2025-01-15T07:00:00-05:00", "values": {"value": 2.0}},
       {"series": "s", "value_time": "2025-01-16T01:00:00.000000Z", "received_time": "2025-01-15T12:00:00.10Z", "values": {"value": 3.0}},
       {"series": "s", "value_time": "2025-01-16T02:00:00.0-00:00", "received_time": "2025-01-15T12:00:00Z", "values": {"value": 4.0}}]},
    {"op": "history", "table": "t",
     "expect": {"rows": [
       {"series": "s", "value_time": "2025-01-16T00:00:00.000001Z", "published_time": null, "received_time": "2025-01-15T12:00:00Z", "system_time": "2025-01-15T12:00:00.123456Z", "seq": 2, "deleted": false, "values": {"value": 2.0}},
       {"series": "s", "value_time": "2025-01-16T00:00:00.500000Z", "published_time": "2025-01-15T07:00:00Z", "received_time": "2025-01-15T11:59:59.999999Z", "system_time": "2025-01-15T12:00:00.123456Z", "seq": 1, "deleted": false, "values": {"value": 1.0}},
       {"series": "s", "value_time": "2025-01-16T01:00:00Z", "published_time": null, "received_time": "2025-01-15T12:00:00.100000Z", "system_time": "2025-01-15T12:00:00.123456Z", "seq": 3, "deleted": false, "values": {"value": 3.0}},
       {"series": "s", "value_time": "2025-01-16T02:00:00Z", "published_time": null, "received_time": "2025-01-15T12:00:00Z", "system_time": "2025-01-15T12:00:00.123456Z", "seq": 4, "deleted": false, "values": {"value": 4.0}}]}},
    {"op": "latest", "table": "t", "frontier": "2025-01-15T12:59:59.999999+01:00",
     "expect": {"values": [["s", "2025-01-16T00:00:00.5Z", {"value": 1.0}]]}},
    {"op": "latest", "table": "t", "frontier": "2025-01-15T12:00:00.099999Z",
     "expect": {"values": [["s", "2025-01-16T00:00:00.000001Z", {"value": 2.0}], ["s", "2025-01-16T00:00:00.500Z", {"value": 1.0}], ["s", "2025-01-16T02:00:00Z", {"value": 4.0}]]}},
    {"op": "latest", "table": "t", "system": "2025-01-15T12:00:00.123455Z", "expect": {"rows": []}},
    {"op": "latest", "table": "t", "system": "2025-01-15T07:00:00.123456-05:00",
     "expect": {"values": [["s", "2025-01-16T00:00:00.000001Z", {"value": 2.0}], ["s", "2025-01-16T00:00:00.5Z", {"value": 1.0}], ["s", "2025-01-16T01:00:00Z", {"value": 3.0}], ["s", "2025-01-16T02:00:00Z", {"value": 4.0}]]}},
    {"op": "latest", "table": "t", "value_from": "2025-01-16T00:00:00.000001Z", "value_to": "2025-01-16T00:00:00.5Z",
     "expect": {"values": [["s", "2025-01-16T00:00:00.000001Z", {"value": 2.0}]]}},
    {"op": "latest", "table": "t", "clock": "published", "frontier": "2025-01-15T07:00:00Z",
     "expect": {"values": [["s", "2025-01-16T00:00:00.5Z", {"value": 1.0}]]}}
  ]
}
