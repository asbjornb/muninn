{
  "name": "catalog-errors",
  "description": "§2/§8 catalog validation: table/column names must match [a-z][a-z0-9_]*, column names must not be reserved, names are unique (columns within a table, series across the whole database). Series names are any non-empty string. Check order per AMBIGUITIES A8 (table uniqueness before column checks; reserved names apply to columns only). Every read op on an unknown table fails with unknown_table. A failed catalog op has no effect.",
  "steps": [
    {"op": "create_table", "name": "Prices", "columns": [], "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "1prices", "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "", "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "prices-dk", "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "_prices", "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "prices", "columns": [{"name": "value_time", "type": "f64"}], "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "prices", "columns": [{"name": "ok", "type": "f64"}, {"name": "Value", "type": "f64"}], "expect": {"error": "invalid_name"}},
    {"op": "create_table", "name": "prices", "columns": [{"name": "value", "type": "f64"}, {"name": "value", "type": "i64"}], "expect": {"error": "already_exists"}},
    {"op": "create_table", "name": "prices", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_table", "name": "prices", "columns": [], "expect": {"error": "already_exists"}},
    {"op": "create_table", "name": "prices", "columns": [{"name": "seq", "type": "f64"}], "expect": {"error": "already_exists"}},
    {"op": "create_table", "name": "values", "columns": [{"name": "a_1", "type": "bool"}]},
    {"op": "create_table", "name": "x9_", "columns": []},
    {"op": "add_column", "table": "nope", "name": "volume", "type": "f64", "expect": {"error": "unknown_table"}},
    {"op": "add_column", "table": "prices", "name": "found", "type": "f64", "expect": {"error": "invalid_name"}},
    {"op": "add_column", "table": "prices", "name": "deleted", "type": "bool", "expect": {"error": "invalid_name"}},
    {"op": "add_column", "table": "prices", "name": "2nd", "type": "f64", "expect": {"error": "invalid_name"}},
    {"op": "add_column", "table": "prices", "name": "value", "type": "i64", "expect": {"error": "already_exists"}},
    {"op": "add_column", "table": "prices", "name": "volume", "type": "f64"},
    {"op": "add_column", "table": "prices", "name": "volume", "type": "f64", "expect": {"error": "already_exists"}},
    {"op": "create_series", "name": "", "table": "prices", "expect": {"error": "invalid_name"}},
    {"op": "create_series", "name": "DK1", "table": "nope", "expect": {"error": "unknown_table"}},
    {"op": "create_series", "name": "DK1 spot (EUR/MWh)", "table": "prices", "tags": {"area": "DK1", "unit": "EUR/MWh"}},
    {"op": "create_series", "name": "DK1 spot (EUR/MWh)", "table": "prices", "expect": {"error": "already_exists"}},
    {"op": "create_series", "name": "DK1 spot (EUR/MWh)", "table": "values", "expect": {"error": "already_exists"}},
    {"op": "create_series", "name": "dk1 spot (eur/mwh)", "table": "values"},
    {"op": "latest", "table": "nope", "expect": {"error": "unknown_table"}},
    {"op": "history", "table": "nope", "expect": {"error": "unknown_table"}},
    {"op": "replay", "table": "nope", "expect": {"error": "unknown_table"}},
    {"op": "grid", "table": "nope", "frontiers": ["2025-01-01T00:00:00Z"], "expect": {"error": "unknown_table"}},
    {"op": "asof_join", "table": "nope", "left": [], "expect": {"error": "unknown_table"}},
    {"op": "latest", "table": "Prices", "expect": {"error": "unknown_table"}},
    {"op": "write", "system_time": "2025-01-01T10:00:00Z",
     "rows": [
       {"series": "DK1 spot (EUR/MWh)", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 50.0, "volume": 1200.0}},
       {"series": "dk1 spot (eur/mwh)", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"a_1": true}}]},
    {"op": "latest", "table": "prices",
     "expect": {"rows": [
       {"series": "DK1 spot (EUR/MWh)", "value_time": "2025-01-02T00:00:00Z", "published_time": null, "received_time": "2025-01-01T09:00:00Z", "system_time": "2025-01-01T10:00:00Z", "seq": 1, "values": {"value": 50.0, "volume": 1200.0}}]}},
    {"op": "latest", "table": "values",
     "expect": {"rows": [
       {"series": "dk1 spot (eur/mwh)", "value_time": "2025-01-02T00:00:00Z", "published_time": null, "received_time": "2025-01-01T09:00:00Z", "system_time": "2025-01-01T10:00:00Z", "seq": 2, "values": {"a_1": true}}]}},
    {"op": "latest", "table": "x9_", "expect": {"rows": []}}
  ]
}
