{
  "name": "tombstone-ordering",
  "description": "§3/§6: a tombstone is an ordinary version in the knowledge order. It hides a point only when it is the latest visible version. A tombstone with an EARLIER received_time than a value version (backfilled retraction) does not hide that value under the received clock, but does under the system clock (same batch, larger seq). history and replay include tombstones (values all null, deleted true); replay `from` is exclusive.",
  "steps": [
    {"op": "create_table", "name": "t", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "s", "table": "t"},
    {"op": "write", "system_time": "2025-01-01T01:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-01T01:00:00Z", "values": {"value": 1.0}}]},
    {"op": "write", "system_time": "2025-01-01T02:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-01T02:00:00Z", "deleted": true}]},
    {"op": "write", "system_time": "2025-01-01T03:00:00Z",
     "rows": [
       {"series": "s", "value_time": "2025-01-01T01:00:00Z", "received_time": "2025-01-01T03:00:00Z", "values": {"value": 5.0}},
       {"series": "s", "value_time": "2025-01-01T01:00:00Z", "received_time": "2025-01-01T02:30:00Z", "deleted": true, "values": {"value": null}}],
     "expect": {"stored": 2, "duplicates": 0, "batch_already_committed": false}},
    {"op": "latest", "table": "t", "expect": {"values": [["s", "2025-01-01T01:00:00Z", {"value": 5.0}]]}},
    {"op": "latest", "table": "t", "frontier": "2025-01-01T02:45:00Z", "expect": {"rows": []}},
    {"op": "latest", "table": "t", "frontier": "2025-01-01T01:59:59Z", "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 1.0}]]}},
    {"op": "latest", "table": "t", "clock": "system", "expect": {"rows": []}},
    {"op": "history", "table": "t",
     "expect": {"values": [
       ["s", "2025-01-01T00:00:00Z", {"value": 1.0}],
       ["s", "2025-01-01T00:00:00Z", "deleted"],
       ["s", "2025-01-01T01:00:00Z", "deleted"],
       ["s", "2025-01-01T01:00:00Z", {"value": 5.0}]]}},
    {"op": "history", "table": "t", "frontier": "2025-01-01T02:00:00Z",
     "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 1.0}], ["s", "2025-01-01T00:00:00Z", "deleted"]]}},
    {"op": "history", "table": "t", "system": "2025-01-01T02:00:00Z",
     "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 1.0}], ["s", "2025-01-01T00:00:00Z", "deleted"]]}},
    {"op": "replay", "table": "t", "from": "2025-01-01T02:00:00Z",
     "expect": {"rows": [
       {"series": "s", "value_time": "2025-01-01T01:00:00Z", "published_time": null, "received_time": "2025-01-01T02:30:00Z", "system_time": "2025-01-01T03:00:00Z", "seq": 4, "deleted": true, "values": {"value": null}},
       {"series": "s", "value_time": "2025-01-01T01:00:00Z", "published_time": null, "received_time": "2025-01-01T03:00:00Z", "system_time": "2025-01-01T03:00:00Z", "seq": 3, "deleted": false, "values": {"value": 5.0}}]}},
    {"op": "write", "system_time": "2025-01-01T04:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-01T04:00:00Z", "values": {"value": 1.0}}]},
    {"op": "latest", "table": "t", "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 1.0}], ["s", "2025-01-01T01:00:00Z", {"value": 5.0}]]}}
  ]
}
