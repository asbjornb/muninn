{
  "name": "timestamp-text-edge-cases",
  "description": "§1 parsing and range (grammar choices in AMBIGUITIES A1): missing Z, space separator, lower-case t/z, non-existent dates, hour 24, leap second, 7 fraction digits, empty fraction, +HHMM offsets, offsets beyond 23:59, single-digit fields and out-of-range instants are invalid_timestamp. The extremes 0001-01-01T00:00:00Z and 9999-12-31T23:59:59.999999Z are valid, as are pre-1970 instants and a year-0000 text whose UTC value is in range; the range check applies after offset conversion.",
  "steps": [
    {"op": "create_table", "name": "t", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "s", "table": "t"},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15 12:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15t12:00:00z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-02-29T00:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2100-02-29T00:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-04-31T00:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T24:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2016-12-31T23:59:60Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00.1234567Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00.Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00+0100", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00+24:00", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-01-15T12:00:00+01:60", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "2025-1-15T12:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "0000-12-31T23:59:59.999999Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "0001-01-01T00:30:00+01:00", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "9999-12-31T23:30:00-01:00", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "10000-01-01T00:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": 1736899200000000, "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z", "rows": [{"series": "s", "value_time": "２025-01-15T12:00:00Z", "received_time": "2025-01-15T00:00:00Z"}], "expect": {"error": "invalid_timestamp"}},
    {"op": "write", "system_time": "2025-01-15T00:00:00Z",
     "rows": [
       {"series": "s", "value_time": "9999-12-31T23:59:59.999999Z", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 5.0}},
       {"series": "s", "value_time": "2024-02-29T00:00:00Z", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 4.0}},
       {"series": "s", "value_time": "2000-02-29T23:59:59Z", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 3.5}},
       {"series": "s", "value_time": "1969-12-31T23:59:59.999999Z", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 3.0}},
       {"series": "s", "value_time": "0000-12-31T23:30:00-01:00", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 2.0}},
       {"series": "s", "value_time": "0001-01-01T00:00:00Z", "received_time": "2025-01-15T00:00:00Z", "values": {"value": 1.0}}],
     "expect": {"stored": 6, "duplicates": 0, "batch_already_committed": false}},
    {"op": "history", "table": "t",
     "expect": {"values": [
       ["s", "0001-01-01T00:00:00Z", {"value": 1.0}],
       ["s", "0001-01-01T00:30:00Z", {"value": 2.0}],
       ["s", "1969-12-31T23:59:59.999999Z", {"value": 3.0}],
       ["s", "2000-02-29T23:59:59Z", {"value": 3.5}],
       ["s", "2024-02-29T00:00:00Z", {"value": 4.0}],
       ["s", "9999-12-31T23:59:59.999999Z", {"value": 5.0}]]}},
    {"op": "latest", "table": "t", "value_from": "1969-12-31T23:59:59.999999Z", "value_to": "1970-01-01T00:00:00Z", "frontier": "9999-12-31T23:59:59.999999Z",
     "expect": {"values": [["s", "1969-12-31T23:59:59.999999Z", {"value": 3.0}]]}},
    {"op": "latest", "table": "t", "frontier": "10000-01-01T00:00:00Z", "expect": {"error": "invalid_timestamp"}},
    {"op": "latest", "table": "t", "frontier": "0001-01-01T00:00:00Z", "expect": {"rows": []}}
  ]
}
