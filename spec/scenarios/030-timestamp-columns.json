{
  "name": "timestamp-columns",
  "description": "§4.1 timestamp-typed value columns accept the §1 text form, offsets converted to UTC; expectations compare them as integers. A value that is not a valid timestamp (wrong form, a number, out of range even via an offset) is type_mismatch, not invalid_timestamp (AMBIGUITIES A4). Equivalent texts of the same instant are duplicates.",
  "steps": [
    {"op": "create_table", "name": "auctions", "columns": [{"name": "gate_closure", "type": "timestamp"}, {"name": "price", "type": "f64"}]},
    {"op": "create_series", "name": "dk1_da", "table": "auctions"},
    {"op": "write", "system_time": "2025-01-15T13:00:00Z",
     "rows": [
       {"series": "dk1_da", "value_time": "2025-01-16T00:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "2025-01-15T12:00:00+01:00", "price": 80.0}},
       {"series": "dk1_da", "value_time": "2025-01-16T01:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "2025-01-15T11:00:00.5Z"}}]},
    {"op": "latest", "table": "auctions",
     "expect": {"rows": [
       {"series": "dk1_da", "value_time": "2025-01-16T00:00:00Z", "published_time": null, "received_time": "2025-01-15T12:45:00Z", "system_time": "2025-01-15T13:00:00Z", "seq": 1, "values": {"gate_closure": "2025-01-15T11:00:00Z", "price": 80.0}},
       {"series": "dk1_da", "value_time": "2025-01-16T01:00:00Z", "published_time": null, "received_time": "2025-01-15T12:45:00Z", "system_time": "2025-01-15T13:00:00Z", "seq": 2, "values": {"gate_closure": "2025-01-15T11:00:00.500000Z", "price": null}}]}},
    {"op": "latest", "table": "auctions",
     "expect": {"values": [
       ["dk1_da", "2025-01-16T00:00:00Z", {"gate_closure": "2025-01-15T06:00:00-05:00"}],
       ["dk1_da", "2025-01-16T01:00:00Z", {"gate_closure": "2025-01-15T11:00:00.500Z"}]]}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z",
     "rows": [{"series": "dk1_da", "value_time": "2025-01-16T00:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "2025-01-15T11:00:00Z", "price": 80}}],
     "expect": {"stored": 0, "duplicates": 1, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "rows": [{"series": "dk1_da", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "2025-01-15"}}], "expect": {"error": "type_mismatch"}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "rows": [{"series": "dk1_da", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": 1736938800000000}}], "expect": {"error": "type_mismatch"}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "rows": [{"series": "dk1_da", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "9999-12-31T23:30:00-01:00"}}], "expect": {"error": "type_mismatch"}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "rows": [{"series": "dk1_da", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"gate_closure": "2025-02-30T00:00:00Z"}}], "expect": {"error": "type_mismatch"}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "rows": [{"series": "dk1_da", "value_time": "2025-01-16T02:00:00Z", "received_time": "bad", "values": {"gate_closure": "2025-02-30T00:00:00Z"}}], "expect": {"error": "type_mismatch"}},
    {"op": "history", "table": "auctions", "expect": {"values": [["dk1_da", "2025-01-16T00:00:00Z", {"price": 80.0}], ["dk1_da", "2025-01-16T01:00:00Z", {"price": null}]]}}
  ]
}
