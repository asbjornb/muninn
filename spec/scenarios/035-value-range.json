{
  "name": "value-range",
  "description": "§6 value range [value_from, value_to): lower bound inclusive, upper exclusive, either may be omitted; equal bounds are an empty range (not an error); value_from > value_to is invalid_range for every read that takes a range. Bounds are timestamps, so offsets and microseconds work.",
  "steps": [
    {"op": "create_table", "name": "prices", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "dk1", "table": "prices"},
    {"op": "write", "system_time": "2025-01-15T13:00:00Z",
     "rows": [
       {"series": "dk1", "value_time": "2025-01-16T00:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"value": 0.0}},
       {"series": "dk1", "value_time": "2025-01-16T01:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"value": 1.0}},
       {"series": "dk1", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"value": 2.0}},
       {"series": "dk1", "value_time": "2025-01-16T03:00:00Z", "received_time": "2025-01-15T12:45:00Z", "values": {"value": 3.0}}]},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T01:00:00Z", "value_to": "2025-01-16T03:00:00Z",
     "expect": {"values": [["dk1", "2025-01-16T01:00:00Z", {"value": 1.0}], ["dk1", "2025-01-16T02:00:00Z", {"value": 2.0}]]}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T01:00:00Z",
     "expect": {"values": [["dk1", "2025-01-16T01:00:00Z", {"value": 1.0}], ["dk1", "2025-01-16T02:00:00Z", {"value": 2.0}], ["dk1", "2025-01-16T03:00:00Z", {"value": 3.0}]]}},
    {"op": "latest", "table": "prices", "value_to": "2025-01-16T01:00:00Z", "expect": {"values": [["dk1", "2025-01-16T00:00:00Z", {"value": 0.0}]]}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T01:00:00Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"rows": []}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T01:00:00.000001Z", "value_to": "2025-01-16T02:00:00.000001Z", "expect": {"values": [["dk1", "2025-01-16T02:00:00Z", {"value": 2.0}]]}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T02:00:00+01:00", "value_to": "2025-01-16T03:00:00+01:00", "expect": {"values": [["dk1", "2025-01-16T01:00:00Z", {"value": 1.0}]]}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T03:00:00Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"error": "invalid_range"}},
    {"op": "latest", "table": "prices", "value_from": "2025-01-16T01:00:00.000001Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"error": "invalid_range"}},
    {"op": "history", "table": "prices", "value_from": "2025-01-16T03:00:00Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"error": "invalid_range"}},
    {"op": "replay", "table": "prices", "value_from": "2025-01-16T03:00:00Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"error": "invalid_range"}},
    {"op": "grid", "table": "prices", "frontiers": ["2025-01-15T13:00:00Z"], "value_from": "2025-01-16T03:00:00Z", "value_to": "2025-01-16T01:00:00Z", "expect": {"error": "invalid_range"}},
    {"op": "history", "table": "prices", "value_from": "2025-01-16T03:00:00Z", "value_to": "2025-01-16T03:00:00Z", "expect": {"rows": []}},
    {"op": "replay", "table": "prices", "value_from": "2025-01-16T02:00:00Z", "expect": {"values": [["dk1", "2025-01-16T02:00:00Z", {"value": 2.0}], ["dk1", "2025-01-16T03:00:00Z", {"value": 3.0}]]}},
    {"op": "grid", "table": "prices", "frontiers": ["2025-01-15T13:00:00Z"], "value_from": "2025-01-16T03:00:00Z",
     "expect": {"values": [["2025-01-15T13:00:00Z", "dk1", "2025-01-16T03:00:00Z", {"value": 3.0}]]}}
  ]
}
