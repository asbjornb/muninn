{
  "name": "batch-id-replay-noop",
  "description": "§4.4: a write whose batch_id was committed before is a no-op regardless of its rows — different rows or even invalid rows are not validated and nothing is stored. A dup-only batch still records its id (§4.5), as does an empty batch.",
  "steps": [
    {"op": "create_table", "name": "wind", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "wind_dk1", "table": "wind"},
    {"op": "write", "system_time": "2025-01-15T10:00:00Z", "batch_id": "ecmwf-2025-01-15T06",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T00:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 1.0}}],
     "expect": {"stored": 1, "duplicates": 0, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-15T11:00:00Z", "batch_id": "ecmwf-2025-01-15T06",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T01:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 2.0}}],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": true}},
    {"op": "write", "system_time": "2025-01-15T11:00:00Z", "batch_id": "ecmwf-2025-01-15T06",
     "rows": [{"series": "no_such_series", "value_time": "garbage", "received_time": "2025-01-15T09:00:00Z", "values": {"value": "x"}}],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": true}},
    {"op": "write", "system_time": "2025-01-15T12:00:00Z",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T02:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 3.0}}],
     "expect": {"stored": 1, "duplicates": 0, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-15T13:00:00Z", "batch_id": "resend",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T00:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 1.0}}],
     "expect": {"stored": 0, "duplicates": 1, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-15T14:00:00Z", "batch_id": "resend",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T03:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 4.0}}],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": true}},
    {"op": "write", "system_time": "2025-01-15T15:00:00Z", "batch_id": "empty", "rows": [],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": false}},
    {"op": "write", "system_time": "2025-01-15T16:00:00Z", "batch_id": "empty",
     "rows": [{"series": "wind_dk1", "value_time": "2025-01-16T04:00:00Z", "received_time": "2025-01-15T09:00:00Z", "values": {"value": 5.0}}],
     "expect": {"stored": 0, "duplicates": 0, "batch_already_committed": true}},
    {"op": "history", "table": "wind",
     "expect": {"rows": [
       {"series": "wind_dk1", "value_time": "2025-01-16T00:00:00Z", "published_time": null, "received_time": "2025-01-15T09:00:00Z", "system_time": "2025-01-15T10:00:00Z", "seq": 1, "deleted": false, "values": {"value": 1.0}},
       {"series": "wind_dk1", "value_time": "2025-01-16T02:00:00Z", "published_time": null, "received_time": "2025-01-15T09:00:00Z", "system_time": "2025-01-15T12:00:00Z", "seq": 2, "deleted": false, "values": {"value": 3.0}}]}}
  ]
}
