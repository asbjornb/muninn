{
  "name": "tombstone-and-undelete",
  "description": "A tombstone hides the point at frontiers after it, not before. Un-deleting is one more version. History and replay include tombstones.",
  "steps": [
    {"op": "create_table", "name": "t", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "s", "table": "t"},
    {"op": "write", "system_time": "2025-01-01T00:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-01T00:00:00Z", "values": {"value": 1.0}}]},
    {"op": "write", "system_time": "2025-01-02T00:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-02T00:00:00Z", "deleted": true}]},
    {"op": "write", "system_time": "2025-01-03T00:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-03T00:00:00Z", "values": {"value": 2.0}}]},
    {"op": "write", "system_time": "2025-01-04T00:00:00Z",
     "rows": [{"series": "s", "value_time": "2025-01-01T00:00:00Z", "received_time": "2025-01-04T00:00:00Z", "deleted": true, "values": {"value": 3.0}}],
     "expect": {"error": "tombstone_with_values"}},
    {"op": "latest", "table": "t", "frontier": "2025-01-01T12:00:00Z",
     "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 1.0}]]}},
    {"op": "latest", "table": "t", "frontier": "2025-01-02T12:00:00Z", "expect": {"rows": []}},
    {"op": "latest", "table": "t",
     "expect": {"values": [["s", "2025-01-01T00:00:00Z", {"value": 2.0}]]}},
    {"op": "replay", "table": "t", "from": "2025-01-01T00:00:00Z", "to": "2025-01-03T00:00:00Z",
     "expect": {"rows": [
       {"series": "s", "value_time": "2025-01-01T00:00:00Z", "published_time": null, "received_time": "2025-01-01T00:00:00Z", "system_time": "2025-01-01T00:00:00Z", "seq": 1, "deleted": false, "values": {"value": 1.0}},
       {"series": "s", "value_time": "2025-01-01T00:00:00Z", "published_time": null, "received_time": "2025-01-02T00:00:00Z", "system_time": "2025-01-02T00:00:00Z", "seq": 2, "deleted": true, "values": {"value": null}}]}}
  ]
}
