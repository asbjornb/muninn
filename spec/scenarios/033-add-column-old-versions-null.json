{
  "name": "add-column-old-versions-null",
  "description": "§2.1 schema evolution: add_column appends a column; versions written before it read it as null in every read (latest, history), and output rows always carry every CURRENT column. Writing to a column that does not exist yet is unknown_column; after add_column the same write succeeds.",
  "steps": [
    {"op": "create_table", "name": "prices", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "dk1", "table": "prices"},
    {"op": "write", "system_time": "2025-01-01T10:00:00Z",
     "rows": [{"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 50.0}}]},
    {"op": "add_column", "table": "prices", "name": "volume", "type": "f64"},
    {"op": "add_column", "table": "prices", "name": "source", "type": "string"},
    {"op": "latest", "table": "prices",
     "expect": {"rows": [
       {"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "published_time": null, "received_time": "2025-01-01T09:00:00Z", "system_time": "2025-01-01T10:00:00Z", "seq": 1, "values": {"value": 50.0, "volume": null, "source": null}}]}},
    {"op": "write", "system_time": "2025-01-01T11:00:00Z",
     "rows": [
       {"series": "dk1", "value_time": "2025-01-02T01:00:00Z", "received_time": "2025-01-01T10:00:00Z", "values": {"value": 51.0, "volume": 100.5, "source": "nordpool"}},
       {"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T10:00:00Z", "values": {"volume": 10.0}}]},
    {"op": "latest", "table": "prices",
     "expect": {"values": [
       ["dk1", "2025-01-02T00:00:00Z", {"value": null, "volume": 10.0, "source": null}],
       ["dk1", "2025-01-02T01:00:00Z", {"value": 51.0, "volume": 100.5, "source": "nordpool"}]]}},
    {"op": "write", "system_time": "2025-01-01T12:00:00Z",
     "rows": [{"series": "dk1", "value_time": "2025-01-02T02:00:00Z", "received_time": "2025-01-01T11:00:00Z", "values": {"currency": "EUR"}}],
     "expect": {"error": "unknown_column"}},
    {"op": "add_column", "table": "prices", "name": "currency", "type": "string"},
    {"op": "write", "system_time": "2025-01-01T12:00:00Z",
     "rows": [{"series": "dk1", "value_time": "2025-01-02T02:00:00Z", "received_time": "2025-01-01T11:00:00Z", "values": {"currency": "EUR"}}],
     "expect": {"stored": 1, "duplicates": 0, "batch_already_committed": false}},
    {"op": "history", "table": "prices", "value_to": "2025-01-02T01:00:00Z",
     "expect": {"rows": [
       {"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "published_time": null, "received_time": "2025-01-01T09:00:00Z", "system_time": "2025-01-01T10:00:00Z", "seq": 1, "deleted": false, "values": {"value": 50.0, "volume": null, "source": null, "currency": null}},
       {"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "published_time": null, "received_time": "2025-01-01T10:00:00Z", "system_time": "2025-01-01T11:00:00Z", "seq": 3, "deleted": false, "values": {"value": null, "volume": 10.0, "source": null, "currency": null}}]}}
  ]
}
