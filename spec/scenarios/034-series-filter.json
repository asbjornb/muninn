{
  "name": "series-filter",
  "description": "§6 series filter: omitted or empty = every series in the read's table (other tables' series never appear). Output is ordered by series id, not by filter order; duplicate names are harmless. A name that does not exist, or belongs to another table, is unknown_series for every read op. A series with no versions contributes nothing.",
  "steps": [
    {"op": "create_table", "name": "prices", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_table", "name": "wind", "columns": [{"name": "value", "type": "f64"}]},
    {"op": "create_series", "name": "dk1", "table": "prices"},
    {"op": "create_series", "name": "dk2", "table": "prices"},
    {"op": "create_series", "name": "wind_dk1", "table": "wind"},
    {"op": "create_series", "name": "de", "table": "prices"},
    {"op": "create_series", "name": "se3", "table": "prices"},
    {"op": "write", "system_time": "2025-01-01T10:00:00Z",
     "rows": [
       {"series": "de", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 4.0}},
       {"series": "wind_dk1", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 3.0}},
       {"series": "dk2", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 2.0}},
       {"series": "dk1", "value_time": "2025-01-02T00:00:00Z", "received_time": "2025-01-01T09:00:00Z", "values": {"value": 1.0}}]},
    {"op": "latest", "table": "prices",
     "expect": {"values": [["dk1", "2025-01-02T00:00:00Z", {"value": 1.0}], ["dk2", "2025-01-02T00:00:00Z", {"value": 2.0}], ["de", "2025-01-02T00:00:00Z", {"value": 4.0}]]}},
    {"op": "latest", "table": "prices", "series": [],
     "expect": {"values": [["dk1", "2025-01-02T00:00:00Z", {"value": 1.0}], ["dk2", "2025-01-02T00:00:00Z", {"value": 2.0}], ["de", "2025-01-02T00:00:00Z", {"value": 4.0}]]}},
    {"op": "latest", "table": "prices", "series": ["de", "dk1"],
     "expect": {"values": [["dk1", "2025-01-02T00:00:00Z", {"value": 1.0}], ["de", "2025-01-02T00:00:00Z", {"value": 4.0}]]}},
    {"op": "latest", "table": "prices", "series": ["dk1", "dk1"], "expect": {"values": [["dk1", "2025-01-02T00:00:00Z", {"value": 1.0}]]}},
    {"op": "latest", "table": "prices", "series": ["se3"], "expect": {"rows": []}},
    {"op": "latest", "table": "wind", "expect": {"values": [["wind_dk1", "2025-01-02T00:00:00Z", {"value": 3.0}]]}},
    {"op": "latest", "table": "prices", "series": ["wind_dk1"], "expect": {"error": "unknown_series"}},
    {"op": "latest", "table": "prices", "series": ["dk1", "nope"], "expect": {"error": "unknown_series"}},
    {"op": "latest", "table": "prices", "series": ["DK1"], "expect": {"error": "unknown_series"}},
    {"op": "history", "table": "prices", "series": ["wind_dk1"], "expect": {"error": "unknown_series"}},
    {"op": "replay", "table": "prices", "series": ["wind_dk1"], "expect": {"error": "unknown_series"}},
    {"op": "grid", "table": "prices", "series": ["wind_dk1"], "frontiers": ["2025-01-01T09:00:00Z"], "expect": {"error": "unknown_series"}},
    {"op": "history", "table": "prices", "series": ["de", "dk2"],
     "expect": {"values": [["dk2", "2025-01-02T00:00:00Z", {"value": 2.0}], ["de", "2025-01-02T00:00:00Z", {"value": 4.0}]]}},
    {"op": "replay", "table": "prices", "series": ["dk1", "de"],
     "expect": {"values": [["de", "2025-01-02T00:00:00Z", {"value": 4.0}], ["dk1", "2025-01-02T00:00:00Z", {"value": 1.0}]]}},
    {"op": "grid", "table": "prices", "series": ["de", "dk2"], "frontiers": ["2025-01-01T09:00:00Z"],
     "expect": {"values": [["2025-01-01T09:00:00Z", "dk2", "2025-01-02T00:00:00Z", {"value": 2.0}], ["2025-01-01T09:00:00Z", "de", "2025-01-02T00:00:00Z", {"value": 4.0}]]}}
  ]
}
