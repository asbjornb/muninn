"""Type stubs for the native extension ``muninn._native`` (PyO3). Internal: use the
``muninn`` package API. Time arguments are already normalised by ``muninn._convert``:
``int`` = µs since the epoch (UTC), ``str`` = SPEC §1 text, anything else = invalid."""

from typing import Any

RECEIPT_KEY: str

_Time = int | str | object | None
_WriteTuple = tuple[int, int, bool, int | None, int | None]

class Snapshot:
    def version(self) -> int: ...
    def last_system_time(self) -> int | None: ...
    def tables(self) -> list[dict[str, Any]]: ...
    def table(self, name: str) -> dict[str, Any]: ...
    def series_list(self, table: str | None = None) -> list[dict[str, Any]]: ...
    def latest(
        self, table: object, series: list[str] | None, value_from: _Time, value_to: _Time,
        clock: str | None, frontier: _Time, system: _Time, *,
        as_of_columns: list[str] | None = None, empty: bool = False,
    ) -> Any: ...  # pyarrow.Table
    def history(
        self, table: object, series: list[str] | None, value_from: _Time, value_to: _Time,
        clock: str | None, frontier: _Time, system: _Time, *,
        as_of_columns: list[str] | None = None, empty: bool = False,
    ) -> Any: ...
    def replay(
        self, table: object, series: list[str] | None, value_from: _Time, value_to: _Time,
        clock: str | None, system: _Time, from_: _Time, to: _Time, *,
        as_of_columns: list[str] | None = None, empty: bool = False,
    ) -> Any: ...
    def grid(
        self, table: object, frontiers: list[_Time] | None, series: list[str] | None,
        value_from: _Time, value_to: _Time, window_start: int | str | object | None,
        window_end: int | str | object | None, clock: str | None, system: _Time, *,
        as_of_columns: list[str] | None = None, empty: bool = False,
    ) -> Any: ...
    def asof_join(
        self, table: object, left: Any, clock: str | None, system: _Time, assume_utc: bool, *,
        as_of_columns: list[str] | None = None, empty: bool = False,
    ) -> Any: ...

class Database:
    def snapshot(self) -> Snapshot: ...
    def version(self) -> int: ...
    def refresh(self) -> int: ...
    def create_table(
        self, name: object, columns: list[tuple[object, object]], default_clock: object,
        partition: object,
    ) -> dict[str, Any]: ...
    def add_column(self, table: object, name: object, type: object) -> dict[str, Any]: ...
    def create_series(
        self, name: object, table: object, tags: object, timezone: object, resolution: object,
    ) -> dict[str, Any]: ...
    def write(
        self, rows: list[Any] | None, arrow: Any, batch_id: object, clock: _Time,
        assume_utc: bool,
    ) -> _WriteTuple: ...
    def write_many(
        self, batches: list[tuple[list[Any] | None, Any, object, _Time]], assume_utc: bool,
    ) -> list[_WriteTuple | Exception]: ...
    def flush(self) -> bool: ...
    def memtable(self) -> tuple[int, int, int, int]: ...
    def compact(self, table: str | None = None, partition: str | None = None) -> int: ...
    def gc(self, grace_us: int | None = None) -> tuple[list[str], int]: ...

def open_local(path: str) -> Database: ...
def memory() -> Database: ...
